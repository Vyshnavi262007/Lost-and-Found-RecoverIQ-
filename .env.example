# Copy to backend/.env (or this folder's .env). NEVER commit the real file.
DJANGO_DEBUG=True
# Generate your own for any non-local use: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

# Database: sqlite (default, nothing to install) or postgres
DB_ENGINE=sqlite
POSTGRES_DB=recoveriq
POSTGRES_USER=recoveriq
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Only fictional email domains are used by the demo data. Replace with your college's domains.
# Entries match the domain and all its subdomains: "edu" accepts any *.edu, "ac.in" any *.ac.in. Use * to accept any email.
ALLOWED_COLLEGE_EMAIL_DOMAINS=edu,ac.in,edu.in,ac.uk,edu.au,ac.nz,edu.sg,edu.my,ac.jp,edu.cn,ac.za,edu.pk,ac.lk

# DEVELOPMENT ONLY: show the verification link in the register response. Set False for deployment.
DEV_EXPOSE_VERIFICATION_LINK=True
# Real email (leave blank to print emails to the backend console)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=

MAX_UPLOAD_MB=5
MAX_IMAGES_PER_REPORT=5

# Demo seed passwords (development only)
DEMO_ADMIN_PASSWORD=RecoverIQ-Admin-2026!
DEMO_USER_PASSWORD=RecoverIQ-Demo-2026!
